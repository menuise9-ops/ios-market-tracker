node_modules/
dist/
build/

# Portable Node.js runtime downloaded locally so this machine (which had no
# Node installed) can run the app — a dev-machine convenience, not source.
.tools/
*.log
.env
.env.local

# Runtime data (not source-controlled — this is user data, not code)
data/app.db
data/app.db-journal
data/app.db-wal
data/app.db-shm
data/raw/*
!data/raw/.gitkeep

# Streamlit app: same rule, but seed.db (a deliberate committed snapshot
# the deployed app boots from) is the one exception — see lib/db.py.
streamlit_app/data/app.db
streamlit_app/data/app.db-journal
streamlit_app/data/app.db-wal
streamlit_app/data/app.db-shm
streamlit_app/data/raw/*
!streamlit_app/data/raw/.gitkeep
__pycache__/
*.pyc
.venv/
venv/

# OS/editor
.DS_Store
Thumbs.db
